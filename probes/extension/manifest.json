{
  "manifest_version": 3,
  "name": "Sharh foundation probe",
  "version": "0.1.0",
  "minimum_chrome_version": "124",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "worker.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "probe.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
