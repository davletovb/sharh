{
  "name": "sharh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "corpus:generate": "node scripts/generate-corpus.mjs",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --test tests/*.test.mjs",
    "test:browser": "npm run build && node --test tests/browser/*.test.mjs",
    "probe:output": "node scripts/probe-output.mjs",
    "probe:authorization": "node scripts/probe-authorization.mjs",
    "verify": "npm test && npm run probe:output -- --fixture",
    "package": "npm run build && node scripts/package.mjs",
    "test:companion": "node scripts/verify-seatline-path.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@fontsource/noto-sans-arabic": "5.3.0",
    "@fontsource/noto-serif": "5.3.0",
    "@mozilla/readability": "0.6.0",
    "@noble/hashes": "2.0.1",
    "d3-force": "3.0.0",
    "d3-hierarchy": "3.1.2",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.4",
    "jsdom": "27.0.1",
    "pdf-lib": "1.17.1",
    "playwright": "1.62.1"
  }
}
