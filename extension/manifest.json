{
  "manifest_version": 3,
  "name": "Sharh",
  "version": "0.1.0",
  "minimum_chrome_version": "124",
  "key": "",
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "nativeMessaging",
    "contextMenus",
    "scripting",
    "activeTab"
  ],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "worker.mjs",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Sharh",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "description": "Read closely with your own models through Seatline.",
  "optional_host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "side_panel": {
    "default_path": "ui/panel.html"
  },
  "options_ui": {
    "page": "ui/settings.html",
    "open_in_tab": true
  }
}
